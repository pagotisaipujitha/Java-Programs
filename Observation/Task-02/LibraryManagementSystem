package corejava;

class Book {

 // Private variables (Encapsulation)
 private int bookId;
 private String bookName;
 private String author;
 private double price;

Book(){
	bookId=0;
	bookName="No Book";
	author="Unknown";
	price=0;
}

 // Parameterized Constructor
 Book(int id, String name, String author, double price) {
     bookId = id;
     bookName = name;
     this.author = author;
     this.price = price;
 }

 // Setter Methods
 public void setBookId(int id) {
     bookId = id;
 }

 public void setBookName(String name) {
     bookName = name;
 }

 public void setAuthor(String author) {
     this.author = author;
 }

 public void setPrice(double price) {
     this.price = price;
 }

 // Getter Methods
 public int getBookId() {
     return bookId;
 }

 public String getBookName() {
     return bookName;
 }

 public String getAuthor() {
     return author;
 }

 public double getPrice() {
     return price;
 }

 // Display Method
 public void displayBook() {
     System.out.println("Book ID : " + bookId);
     System.out.println("Book Name : " + bookName);
     System.out.println("Author : " + author);
     System.out.println("Price : " + price);
 }
}

//=====================
//PART C
//Inheritance
//=====================

class Person {

 String name;
 int age;

 Person(String name, int age) {
     this.name = name;
     this.age = age;
 }

 public void displayPerson() {
     System.out.println("Name : " + name);
     System.out.println("Age : " + age);
 }
}

class Student extends Person {

 int studentId;

 Student(String name, int age, int studentId) {
     super(name, age);
     this.studentId = studentId;
 }

 public void displayStudent() {
     displayPerson();
     System.out.println("Student ID : " + studentId);
 }
}

class Faculty extends Person {

 String subject;

 Faculty(String name, int age, String subject) {
     super(name, age);
     this.subject = subject;
 }

 public void displayFaculty() {
     displayPerson();
     System.out.println("Subject : " + subject);
 }
}

//=====================
//PART D
//Method Overloading
//=====================

class Area {

 // Square
 public void area(int side) {
     System.out.println("Area of Square = " + (side * side));
 }

 // Rectangle
 public void area(int length, int breadth) {
     System.out.println("Area of Rectangle = " + (length * breadth));
 }

 // Circle
 public void area(double radius) {
     System.out.println("Area of Circle = " + (3.14 * radius * radius));
 }
}

//=====================
//Method Overriding
//=====================

class Vehicle {

 public void display() {
     System.out.println("This is a Vehicle.");
 }
}

class Car extends Vehicle {

 public void display() {
     System.out.println("This is a Car.");
 }
}

class Bike extends Vehicle {

 public void display() {
     System.out.println("This is a Bike.");
 }
}

//=====================
//PART E
//Abstraction
//=====================

abstract class Shape {

 abstract void draw();
}

class Circle extends Shape {

 public void draw() {
     System.out.println("Drawing Circle");
 }
}

class Rectangle extends Shape {

 public void draw() {
     System.out.println("Drawing Rectangle");
 }
}

//=====================
//Interface
//=====================

interface Printable {

 void print();
}

class Report implements Printable {

 public void print() {
     System.out.println("Printing Report");
 }
}

//=====================
//Main Class
//=====================

public class LibraryManage
{

 public static void main(String[] args) {

     // PART A & B
     System.out.println("BOOK DETAILS");

     Book b1 = new Book();
     b1.displayBook();

     System.out.println();

     Book b2 = new Book(101, "Java Programming", "James Gosling", 500);
     b2.displayBook();

     // Using Setter
     b2.setPrice(600);

     System.out.println("Updated Price = " + b2.getPrice());

     // PART C
     System.out.println("\nINHERITANCE");

     Student s = new Student("Sai", 20, 101);
     s.displayStudent();

     System.out.println();

     Faculty f = new Faculty("Ravi", 40, "Java");
     f.displayFaculty();

     // PART D
     System.out.println("\nMETHOD OVERLOADING");

     Area a = new Area();

     a.area(5);          // Square
     a.area(10, 5);      // Rectangle
     a.area(4.0);        // Circle

     // Method Overriding
     System.out.println("\nMETHOD OVERRIDING");

     Vehicle v;

     v = new Car();
     v.display();

     v = new Bike();
     v.display();

     // PART E
     System.out.println("\nABSTRACTION");

     Shape sh;

     sh = new Circle();
     sh.draw();

     sh = new Rectangle();
     sh.draw();

     // Interface
     System.out.println("\nINTERFACE");

     Report r = new Report();
     r.print();
 }
}
