package ride;
import java.util.Scanner;

//Interface
interface Employee {
 void salaryDetails();
}


//Regular Employee class
class RegularEmployee implements Employee {

 int basicPay = 25000;
 int hra = 15000;
 int ta = 5000;

 
 public void salaryDetails() {
     int total = basicPay + hra + ta;

     System.out.println("Salary Details:");
     System.out.println("Basic Pay: " + basicPay);
     System.out.println("HRA: " + hra);
     System.out.println("T.A: " + ta);
     System.out.println("Total Amount: " + total);
 }
}


//Contract Employee class
class ContractEmployee implements Employee {

 int basicPay = 12000;
 int ta = 3000;

 
 public void salaryDetails() {
     int total = basicPay + ta;

     System.out.println("Salary Details:");
     System.out.println("Basic Pay: " + basicPay);
     System.out.println("T.A: " + ta);
     System.out.println("HRA: No HRA");
     System.out.println("Total Amount: " + total);
 }
}


//Main class
public class SalaryDetails {

 public static void main(String[] args) {

     Scanner sc = new Scanner(System.in);

     System.out.print("Enter Employee Id: ");
     String id = sc.nextLine();

     Employee employee;

     if (id.startsWith("R")) {
         employee = new RegularEmployee();
         employee.salaryDetails();
     }
     else if (id.startsWith("C")) {
         employee = new ContractEmployee();
         employee.salaryDetails();
     }
     else {
         System.out.println("Invalid Employee Id");
     }

     sc.close();
 }
}


