package ride;


interface I1{
    int x=100;
    abstract void sample();
        }
        interface I2{
    int y=20;
    abstract void sum();
        }



public class C1ImplI1AndI2 implements I1,I2 {

   @Override
    public void sample() {
        System.out.println("this is in I1");
        System.out.println("the sum of the numbers is"+(x+y));
    }
   @Override
    public void sum()
    {
        System.out.println("this is in I2");
        System.out.println("the sub of two numbers is :"+(x-y));
    }
    public static void main(String[] args) {
C1ImplI1AndI2 obj=new C1ImplI1AndI2();
obj.sample();
obj.sum();
    }
}


    
